---
// A screenshot of the admin UI in the reader's theme, from the screenshots of
// the page's docs version (src/assets/screenshots/<version>/<name>-light|dark.png,
// made by `mise run docs:screenshots`). `next` falls back to the latest release.
// Click opens the full-size image.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { LATEST, versionOf } from "../../docs/versions";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/screenshots/*/*.png", { eager: true });
const version = versionOf(Astro.locals.starlightRoute?.id ?? Astro.url.pathname);
const find = (dir: string, theme: string) => shots[`/src/assets/screenshots/${dir}/${name}-${theme}.png`]?.default;
const pick = (theme: string) => find(version.id, theme) ?? find(LATEST.id, theme);
const light = pick("light");
const dark = pick("dark");
const missing = !light || !dark;
// A missing screenshot fails the build; in dev it shows as a placeholder.
if (missing && !import.meta.env.DEV) throw new Error(`Screenshot "${name}" is missing in src/assets/screenshots/${LATEST.id}/`);
const widths = [760, 1520];
const sizes = "(min-width: 72rem) 46rem, 100vw";
---
<figure class="shot not-content">
  {missing ? (
    <div class="missing">screenshot "{name}" missing</div>
  ) : (
    <>
      <a class="for-light" href={light!.src} target="_blank" rel="noopener">
        <Image src={light!} alt={alt} widths={widths} sizes={sizes} />
      </a>
      <a class="for-dark" href={dark!.src} target="_blank" rel="noopener">
        <Image src={dark!} alt={alt} widths={widths} sizes={sizes} />
      </a>
    </>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot a {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  /* One image per theme; Starlight's dark (the default without JS) unless light. */
  :global(:root:not([data-theme="light"])) .for-light,
  :global(:root[data-theme="light"]) .for-dark {
    display: none;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .missing {
    padding: 3rem 1rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
    font: 13px var(--font-mono);
    color: var(--fg-subtle);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
