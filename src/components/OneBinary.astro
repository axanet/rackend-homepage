---
import SectionHead from "./SectionHead.astro";
import { Code } from "astro:components";

const themes = { light: "github-light", dark: "github-dark-dimmed" } as const;

const runsOn = ["a €5 VPS", "a Raspberry Pi-class board", "your homelab", "Coolify", "Unraid"];
---
<section id="ops" class="section" aria-labelledby="ops-title">
  <div class="container">
    <SectionHead index="04" label="Operations" id="ops-title" title="One process. One data directory.">
      No Postgres, Redis or queue to run next to it. One static binary or one small Docker image,
      for amd64 and arm64.
    </SectionHead>

    <div class="grid">
      <div class="col">
        <article class="item panel">
          <h3>Zero config to start</h3>
          <p>
            Everything is configured at runtime in the admin UI. Environment variables exist only for
            bootstrapping: listen address, data directory, an optional encryption key.
          </p>
          <div class="code panel">
            <Code
              lang="yaml"
              themes={themes}
              defaultColor={false}
              code={`services:
  rackend:
    image: ghcr.io/axanet/rackend:1.0   # pin a minor version
    ports: ["8080:8080"]
    volumes: ["rackend_data:/data"]
volumes:
  rackend_data:`}
            />
          </div>
        </article>

        <article class="item panel">
          <h3>Runs where you already are</h3>
          <ul class="chips">
            {runsOn.map((r) => <li>{r}</li>)}
          </ul>
        </article>
      </div>

      <article class="arch panel" aria-labelledby="arch-title">
        <div class="arch-head">
          <h3 id="arch-title">Inside the binary</h3>
          <p>
            A hexagonal core with no I/O of its own. Everything it talks to sits behind a port, so new
            adapters such as gRPC or MCP can be added later without touching it.
          </p>
        </div>

        <figure class="stack" aria-label="Architecture, from top to bottom">
          <div class="binary">
            <p class="binary-label"><span class="pip" aria-hidden="true"></span>rackend <span>· one process</span></p>

            <div class="layer">
              <p class="layer-label">Adapters in</p>
              <ul class="nodes in">
                <li class="node live">HTTP<small>REST · SSE · WebSocket · OIDC</small></li>
                <li class="node later">gRPC<small>later</small></li>
                <li class="node later">MCP<small>later</small></li>
              </ul>
            </div>

            <div class="link" aria-hidden="true"></div>

            <div class="layer core">
              <p class="layer-label">Core</p>
              <ul class="chips">
                <li>collections</li><li>rules</li><li>auth · OIDC</li><li>files</li><li>realtime</li><li>audit</li>
              </ul>
            </div>

            <div class="link" aria-hidden="true"></div>

            <div class="layer">
              <p class="layer-label">Adapters out</p>
              <ul class="nodes">
                <li class="node">SQLite</li>
                <li class="node">files<small>disk or S3</small></li>
                <li class="node">images</li>
                <li class="node">mail</li>
              </ul>
            </div>
          </div>

          <div class="link outside" aria-hidden="true"></div>

          <div class="datadir">
            <p class="layer-label">Data directory</p>
            <ul class="files">
              <li>data.db</li><li>logs.db</li><li>storage/</li><li>backups/</li>
            </ul>
          </div>
        </figure>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px;
  }
  .col { display: grid; gap: 16px; align-content: start; min-width: 0; }
  .item { display: grid; gap: 12px; padding: 24px; min-width: 0; }
  .item h3, .arch h3 { font-size: 1.15rem; letter-spacing: -0.015em; }
  .item p, .arch-head p { color: var(--fg-muted); font-size: 15px; }
  .code { background: var(--surface); overflow: hidden; }
  .code :global(pre.astro-code) { padding: 14px 16px; font-size: 12.5px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .chips li {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font: 12px/1.4 var(--font-mono);
    color: var(--fg-muted);
  }

  .arch { padding: 24px; display: grid; gap: 24px; align-content: start; min-width: 0; }
  .arch-head { display: grid; gap: 6px; max-width: 540px; }

  .stack { margin: 0; display: grid; }
  .binary {
    position: relative;
    display: grid;
    padding: 30px 16px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .binary-label {
    position: absolute;
    top: -11px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 2px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elev);
    font: 500 12px/1.4 var(--font-mono);
  }
  .binary-label span:not(.pip) { color: var(--fg-subtle); }
  .pip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .layer { display: grid; gap: 10px; }
  .layer-label {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 110px), 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nodes.in { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); }
  @media (max-width: 480px) {
    .nodes.in { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .nodes.in .live { grid-column: 1 / -1; }
  }
  .node {
    display: grid;
    gap: 2px;
    align-content: center;
    min-height: 52px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    font: 500 13px/1.3 var(--font-mono);
  }
  .node small { font-size: 11px; font-weight: 400; color: var(--fg-subtle); }
  .node.live { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .node.later { border-style: dashed; background: transparent; color: var(--fg-muted); }

  .core {
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  .core .layer-label { color: var(--accent-text); }
  .core .chips li { background: var(--bg-elev); color: var(--fg); }

  /* a short vertical connector between layers */
  .link {
    position: relative;
    height: 22px;
  }
  .link::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--border-strong);
  }
  .link::after {
    content: "";
    position: absolute;
    left: calc(50% - 3px);
    bottom: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .link.outside::before { border-left-style: dashed; }

  .datadir {
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .files li {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    font: 12px/1.4 var(--font-mono);
    color: var(--fg-muted);
  }
  .files li:first-child { color: var(--fg); border-color: var(--border-strong); }

  @media (max-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
