---
import CopyCommand from "./CopyCommand.astro";
import HostScene from "../visual/HostScene.astro";
import GitHubIcon from "./icons/GitHub.astro";
import Arrow from "./icons/Arrow.astro";
import { SITE, LINKS } from "../config/site";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      {SITE.status && <p class="status"><span class="pip"></span>{SITE.status}</p>}
      <p class="eyebrow">Open-source backend-as-a-service</p>
      <h1 id="hero-title">
        Your whole backend<br class="br" /> in one binary.
      </h1>
      <p class="lede">
        Collections, REST API, auth, file storage and realtime in a single Rust binary backed by
        SQLite. Self-hosted, open source, zero config.
      </p>

      <div class="ctas">
        <a class="btn btn-primary" href="#quickstart">Get started <Arrow /></a>
        <a class="btn btn-ghost" href={LINKS.github}><GitHubIcon /> View on GitHub</a>
      </div>

      <CopyCommand command={SITE.runCommand} label="docker run" class="run" />

      <ul class="facts" aria-label="At a glance">
        <li>Single static binary</li>
        <li>SQLite</li>
        <li>amd64 + arm64</li>
        <li>No external services</li>
      </ul>
    </div>

    <div class="visual">
      <HostScene />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 96px) clamp(64px, 9vw, 120px);
    overflow: clip;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 72% 38%, var(--accent-soft), transparent 70%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(90% 75% at 50% 30%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(90% 75% at 50% 30%, #000 30%, transparent 85%);
    opacity: 0.55;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }
  .copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; justify-items: start; min-width: 0; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font: 500 12px/1.4 var(--font-mono);
    color: var(--fg-muted);
  }
  .pip { width: 6px; height: 6px; border-radius: 50%; background: var(--write); }
  h1 {
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
    font-weight: 600;
  }
  .lede {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--fg-muted);
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .copy :global(.run) { width: 100%; max-width: 560px; }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .facts li { display: inline-flex; align-items: center; gap: 8px; }
  .facts li::before { content: ""; width: 4px; height: 4px; border-radius: 1px; background: var(--border-strong); }
  .visual { min-width: 0; }

  @media (max-width: 1023px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .visual { max-width: 720px; width: 100%; justify-self: center; }
  }
  @media (max-width: 480px) {
    .br { display: none; }
  }
</style>
