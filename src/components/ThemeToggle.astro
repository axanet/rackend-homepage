---
// Cycles system → light → dark. Hidden without JS (the OS preference applies).
---
<button class="theme-toggle" type="button" aria-label="Theme: system" data-theme-toggle hidden>
  <svg class="i-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"/></svg>
  <svg class="i-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 016.4 2.5a5.6 5.6 0 107.1 7.1z"/></svg>
  <svg class="i-system" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2.5" width="12" height="8.5" rx="1.5"/><path d="M6 14h4M8 11v3"/></svg>
</button>

<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Mode = (typeof ORDER)[number];
  const root = document.documentElement;
  const mq = matchMedia("(prefers-color-scheme: dark)");

  const read = (): Mode => {
    try {
      const v = localStorage.getItem("theme");
      return v === "light" || v === "dark" ? v : "system";
    } catch {
      return "system";
    }
  };
  const apply = (mode: Mode) => {
    try {
      mode === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", mode);
    } catch {}
    root.dataset.theme = mode === "system" ? (mq.matches ? "dark" : "light") : mode;
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      btn.dataset.mode = mode;
      btn.setAttribute("aria-label", `Theme: ${mode}. Switch theme`);
    }
  };

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    btn.hidden = false;
    btn.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]!;
      apply(next);
    });
  }
  apply(read());
  mq.addEventListener("change", () => read() === "system" && apply("system"));
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--fg); background: var(--surface); }
  .theme-toggle svg { width: 16px; height: 16px; display: none; }
  .theme-toggle[data-mode="light"] .i-sun,
  .theme-toggle[data-mode="dark"] .i-moon,
  .theme-toggle[data-mode="system"] .i-system,
  .theme-toggle:not([data-mode]) .i-system { display: block; }
</style>
